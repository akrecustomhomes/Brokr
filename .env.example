# Brokr only. Do not reuse AkreGC Supabase, Vercel, or storage values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only values for future Supabase Edge Functions / Vercel API routes.
# Do not expose these in browser-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_BASE_URL=https://your-vercel-app.vercel.app

# Optional email provider for user invites and broker notifications.
RESEND_API_KEY=your-resend-api-key
BROKR_FROM_EMAIL=notifications@yourdomain.com

# Optional Google Drive archive integration.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
