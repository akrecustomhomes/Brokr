{
  "name": "brokr",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/license-reminders",
      "schedule": "0 15 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/q/:slug",
      "destination": "/api/scan/:slug"
    }
  ]
}
